---
import "../styles/global.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import { siteConfig } from "../data/site";

export type NavKey = "home" | "writing" | "about" | "mentoring" | "ebook" | "contact";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: NavKey;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  ogImage = siteConfig.defaultOgImage,
  current,
  noindex = false,
} = Astro.props;

const fullTitle =
  title === siteConfig.logoText || title === "Home"
    ? `${siteConfig.authorKo}(${siteConfig.authorEn}) — Product Manager`
    : `${title} — ${siteConfig.authorKo}(${siteConfig.authorEn})`;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImageURL = new URL(ogImage, siteConfig.url).toString();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <link
      rel="preload"
      href="/fonts/PretendardVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteConfig.domain} />
    <meta property="og:locale" content="ko_KR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <Header current={current} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
