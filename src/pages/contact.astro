---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import { siteConfig, externalLinks } from "../data/site";

const inquiryTypes = [
  {
    label: "협업·강연·미디어",
    description: "기업 사내 강연, 인터뷰, 콘텐츠 협업 등 비즈니스 문의",
    via: "Email",
    channel: `mailto:${siteConfig.email}`,
    channelLabel: siteConfig.email,
  },
  {
    label: "멘토링 신청",
    description: "1:1 커리어/포트폴리오 멘토링 프로그램 신청은 별도 페이지에서",
    via: "Page",
    channel: "/mentoring",
    channelLabel: "멘토링 페이지로 이동",
  },
  {
    label: "포트폴리오·취업 질문",
    description: "짧은 질문은 DM으로, 진지한 상담은 멘토링으로 진행해주세요",
    via: "Instagram",
    channel: externalLinks.instagram,
    channelLabel: siteConfig.instagramHandle,
    external: true,
  },
];
---

<BaseLayout
  title="Contact"
  description="비즈니스 협업·강연·미디어 문의는 이메일로, 짧은 질문은 인스타그램 DM으로 부탁드립니다."
  current="contact"
>
  <!-- HERO -->
  <section class="contact-hero">
    <div class="container-wide">
      <SectionTitle eyebrow="Contact" title="문의" level={1} />
      <p class="hero-body">
        용건에 따라 채널을 분리해 사용하고 있습니다. 아래 표에서 가장 가까운 항목을
        선택해주세요. 답변은 평일 기준 <span class="marker">24–48시간 내</span>에 드립니다.
      </p>
    </div>
  </section>

  <!-- INQUIRY CHANNELS -->
  <section class="channels-section">
    <div class="container-wide">
      <dl class="channels-list">
        {
          inquiryTypes.map((t) => (
            <div class="channel-row">
              <dt class="channel-label">
                <span class="via">{t.via}</span>
                <span class="label">{t.label}</span>
              </dt>
              <dd class="channel-detail">
                <p class="desc">{t.description}</p>
                <a
                  class="channel-link"
                  href={t.channel}
                  target={t.external ? "_blank" : undefined}
                  rel={t.external ? "noopener noreferrer" : undefined}
                >
                  {t.channelLabel}
                  {t.external && <span aria-hidden="true"> ↗</span>}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- SOCIAL ROW -->
  <section class="social-section">
    <div class="container-wide">
      <SectionTitle eyebrow="Around the web" title="다른 채널" level={2} />
      <ul class="social-list">
        <li>
          <span class="social-label">Instagram</span>
          <a href={externalLinks.instagram} target="_blank" rel="noopener noreferrer">
            {siteConfig.instagramHandle} <span aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <span class="social-label">Brunch</span>
          <a href={externalLinks.brunch} target="_blank" rel="noopener noreferrer">
            {siteConfig.brunchHandle} <span aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <span class="social-label">LinkedIn</span>
          <a href={externalLinks.linkedin} target="_blank" rel="noopener noreferrer">
            {siteConfig.linkedinName} <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- NOTES -->
  <section class="notes-section">
    <div class="container-wide">
      <SectionTitle eyebrow="Notes" title="문의 시 참고" level={2} />
      <ul class="notes-list">
        <li>
          답변은 평일 기준 24–48시간 내. 주말·휴일·해외 출장 시 더 늦어질 수 있습니다.
        </li>
        <li>
          멘토링 일정 변경, 환불 등 진행 중인 신청 관련 문의는 신청 시 받은 이메일로
          회신해주세요. (별도 채널로 들어오면 누락 가능성이 있습니다.)
        </li>
        <li>
          광고·홍보·SEO 대행·MLM 등 영업성 문의는 응답하지 않습니다.
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-block: var(--space-8) var(--space-5);
  }

  .hero-body {
    margin-top: var(--space-4);
    max-width: 64ch;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-relaxed);
    color: var(--color-text-sub);
  }

  /* Common section */
  .channels-section,
  .social-section,
  .notes-section {
    padding-block: var(--space-6) var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  /* Channels list */
  .channels-list {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .channel-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }

  .channel-row:first-child {
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .channel-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  .channel-label {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .channel-label .via {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .channel-label .label {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text);
    line-height: var(--lh-tight);
  }

  .channel-detail {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .channel-detail .desc {
    margin: 0;
    font-size: var(--fs-body);
    color: var(--color-text-sub);
    line-height: var(--lh-relaxed);
  }

  .channel-link {
    align-self: flex-start;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 2px;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .channel-link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* Social list */
  .social-list {
    margin-top: var(--space-5);
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .social-list li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }

  .social-list li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .social-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .social-list a {
    font-size: var(--fs-body);
    color: var(--color-text);
    transition: color 140ms ease;
  }

  .social-list a:hover {
    color: var(--color-accent);
  }

  /* Notes */
  .notes-list {
    margin-top: var(--space-5);
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--container-narrow);
    font-size: var(--fs-body);
    color: var(--color-text-sub);
    line-height: var(--lh-relaxed);
  }

  .notes-list li {
    position: relative;
    padding-left: var(--space-2);
  }

  .notes-list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }
</style>
