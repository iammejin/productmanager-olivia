---
import { siteConfig, externalLinks } from "../../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-full footer-inner">
    <div class="footer-left">
      <div class="footer-logo">
        <span>olivia</span><span class="dot">.</span>
      </div>
      <p class="footer-tagline">
        © {year} {siteConfig.authorKo} ({siteConfig.authorEn}). All rights reserved.
      </p>
    </div>
    <nav class="footer-links" aria-label="footer">
      <a href={externalLinks.instagram} target="_blank" rel="noopener noreferrer">
        Instagram <span aria-hidden="true">↗</span>
      </a>
      <a href={externalLinks.brunch} target="_blank" rel="noopener noreferrer">
        Brunch <span aria-hidden="true">↗</span>
      </a>
      <a href={`mailto:${siteConfig.email}`}>Email</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-9);
    padding-block: var(--space-6);
    background: var(--color-bg);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .footer-logo {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  .footer-logo .dot {
    color: var(--color-accent);
  }

  .footer-tagline {
    margin-top: var(--space-1);
    font-size: var(--fs-caption);
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--fs-caption);
  }

  .footer-links a {
    color: var(--color-text-sub);
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: var(--space-3);
    }
  }
</style>
