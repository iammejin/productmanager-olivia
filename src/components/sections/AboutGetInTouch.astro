---
import SectionTitle from "../ui/SectionTitle.astro";
import { siteConfig, externalLinks } from "../../data/site";
---

<section class="about-getintouch">
  <div class="container-full getintouch-inner">
    <SectionTitle eyebrow="Get in touch" title="협업·강연·미디어 문의" level={2} />

    <div class="getintouch-body">
      <p>
        협업 · 강연 · 미디어 문의는 이메일로 보내주세요. 멘토링 신청은 별도 페이지를 통해
        진행해주세요.
      </p>

      <div class="contact-actions">
        <a class="contact-action primary" href={`mailto:${siteConfig.email}`}>
          {siteConfig.email}
        </a>
        <a
          class="contact-action"
          href={externalLinks.instagram}
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram {siteConfig.instagramHandle} <span aria-hidden="true">↗</span>
        </a>
        <a class="contact-action" href="/mentoring">멘토링 신청</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-getintouch {
    padding-block: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  .getintouch-inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .getintouch-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--fs-body-lg);
    line-height: var(--lh-relaxed);
    color: var(--color-text-sub);
    max-width: 60ch;
  }

  .getintouch-body p {
    margin: 0;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .contact-action {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: var(--fs-body);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .contact-action.primary {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text);
  }

  .contact-action:hover {
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .getintouch-inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .getintouch-body {
      font-size: var(--fs-body);
    }
  }
</style>
