---
import type { Review } from "../../data/mentoring";

interface Props {
  review: Review;
}

const { review } = Astro.props;
const { quote, author, authorMeta, program, date } = review;

const formattedDate = date
  ? `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}`
  : undefined;
---

<figure class="review-card">
  <blockquote class="quote">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="byline">
    <span class="author">{author}</span>
    {authorMeta && <span class="meta"> · {authorMeta}</span>}
    {program && <span class="program">{program}</span>}
    {formattedDate && <span class="date">{formattedDate}</span>}
  </figcaption>
</figure>

<style>
  .review-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .quote {
    margin: 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-line-strong);
  }

  .quote p {
    margin: 0;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-relaxed);
    color: var(--color-text);
    font-style: normal;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-left: calc(var(--space-3) + 2px);
    font-size: var(--fs-caption);
    color: var(--color-text-muted);
  }

  .author {
    font-weight: 600;
    color: var(--color-text-sub);
  }

  .program {
    color: var(--color-accent);
    font-weight: 500;
  }
</style>
