---
import TagBadge from "../ui/TagBadge.astro";

interface Props {
  href: string;
  title: string;
  description?: string;
  date: Date;
  tags: string[];
  cover?: string;
  coverAlt?: string;
}

const { href, title, description, date, tags, cover, coverAlt } = Astro.props;

const formattedDate = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---

<a href={href} class="writing-item">
  <time class="date" datetime={date.toISOString()}>{formattedDate}</time>
  <div class="body">
    <h3 class="title">{title}</h3>
    {description && <p class="description">{description}</p>}
    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>
              <TagBadge label={`#${tag}`} variant="default" size="sm" />
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="thumb" aria-hidden={cover ? undefined : "true"}>
    {cover ? (
      <img src={cover} alt={coverAlt ?? title} loading="lazy" decoding="async" />
    ) : (
      <span class="thumb-placeholder">No image</span>
    )}
  </div>
</a>

<style>
  .writing-item {
    display: grid;
    grid-template-columns: 100px 1fr 160px;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
    color: var(--color-text);
    transition: color 140ms ease;
  }

  .writing-item:hover .title {
    color: var(--color-accent);
  }

  .date {
    font-size: var(--fs-caption);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    align-self: flex-start;
    padding-top: 4px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .title {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
    color: var(--color-text);
    margin: 0;
    transition: color 140ms ease;
  }

  .description {
    font-size: var(--fs-body);
    color: var(--color-text-sub);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  .tags {
    list-style: none;
    margin: 0;
    margin-top: var(--space-1);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .thumb {
    width: 160px;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thumb-placeholder {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .writing-item {
      grid-template-columns: 100px 1fr;
      grid-template-areas:
        "date thumb"
        "body body";
      gap: var(--space-2);
    }

    .date {
      grid-area: date;
    }

    .thumb {
      grid-area: thumb;
      justify-self: end;
      width: 120px;
    }

    .body {
      grid-area: body;
    }
  }

  @media (max-width: 480px) {
    .writing-item {
      grid-template-columns: 1fr;
      grid-template-areas:
        "thumb"
        "date"
        "body";
    }

    .thumb {
      justify-self: stretch;
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>
